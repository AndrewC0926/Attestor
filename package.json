{
  "name": "attestor",
  "version": "0.1.0",
  "private": true,
  "description": "Risk-tiered, autonomy-aware governance runtime and tamper-evident evidence system of record for AI agents.",
  "license": "LicenseRef-BSL-1.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/types",
    "packages/spine",
    "packages/gateway",
    "packages/showcase",
    "packages/anchor",
    "packages/cli"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --build --dry || tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "demo": "tsx packages/cli/src/index.ts demo"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
