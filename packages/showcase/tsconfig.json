{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // Same MCP SDK boundary issue the gateway documents: the SDK's Transport
    // types declare optional members as `T | undefined` rather than truly
    // optional, which clashes with exactOptionalPropertyTypes when wiring the
    // in-process Client/Server. Scope that one flag off here only; all other
    // strict checks remain on.
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../types" },
    { "path": "../spine" },
    { "path": "../gateway" }
  ]
}
